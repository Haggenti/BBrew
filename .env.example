# Copy this file to .env on the Odroid and replace every example value.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=odroid-hc4,192.168.1.XX
DJANGO_CSRF_TRUSTED_ORIGINS=http://odroid-hc4:8000,http://192.168.1.XX:8000
DJANGO_SECURE_COOKIES=0
# Set both secure options to 1 only when TLS terminates at a trusted reverse proxy.
DJANGO_SECURE_PROXY_SSL_HEADER=0

# Use an absolute path on a persistent disk mounted by DietPi.
BBREW_HOST_DATA_DIR=/mnt/dietpi_userdata/bbrew-data
BBREW_PORT=8000
